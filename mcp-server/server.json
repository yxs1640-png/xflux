{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.yxs1640-png/xflux",
  "description": "Search X/Twitter tweets, profiles, and timelines via the XFlux read API.",
  "repository": {
    "url": "https://github.com/yxs1640-png/xflux",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@xflux/xflux-mcp-server",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "XFLUX_API_KEY",
          "description": "API key from https://www.xfluxapi.com/dashboard/api-keys",
          "isRequired": true,
          "format": "string",
          "isSecret": true
        },
        {
          "name": "XFLUX_API_BASE",
          "description": "Optional API base URL (default https://www.xfluxapi.com/api/v1)",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        }
      ]
    }
  ]
}
