# XFlux Monitor Worker — build from repository root:
#   fly deploy . --config worker/fly.toml -a xflux-monitor-worker

FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
COPY tsconfig.worker.json ./
COPY prisma ./prisma
COPY src/lib ./src/lib
COPY src/worker ./src/worker

RUN npm ci && npx prisma generate && npm run worker:build

FROM node:22-alpine
WORKDIR /app

ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY prisma ./prisma
# prisma CLI lives in devDependencies; skip lifecycle scripts and reuse
# the generated client from the builder stage instead of generating here.
RUN npm ci --omit=dev --ignore-scripts

COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=builder /app/dist ./dist

CMD ["node", "dist/worker/run.js"]
