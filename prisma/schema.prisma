generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlanTier {
  FREE
  BASIC
  GROWTH
  PRO
  SCALE
  ENTERPRISE
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum JobType {
  TWEET
  DM
  MONITOR
  BATCH
}

enum MonitorStatus {
  ACTIVE
  PAUSED
  ERROR
}

enum WebhookDeliveryEvent {
  TEST
  HIT
}

enum WebhookDeliveryStatus {
  SUCCESS
  FAILED
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String?
  passwordHash           String
  planTier               PlanTier  @default(FREE)
  quotaLimit             Int       @default(1000)
  quotaUsed              Int       @default(0)
  quotaResetAt           DateTime  @default(now())
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  subscriptionStatus     String?
  subscriptionPeriodEnd  DateTime?
  pendingPlanTier          PlanTier?
  planChangeEffectiveAt    DateTime?
  lastPlanChangeSummary    Json?
  planChangeBannerDismissedAt DateTime?
  monitorHitsReadAt        DateTime?
  signupSource           String?
  signupSourceDetail     String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  apiKeys              ApiKey[]
  apiLogs              ApiLog[]
  apiRateLimitWindows  ApiRateLimitWindow[]
  monitorTasks  MonitorTask[]
  jobs          Job[]
  feedback      UserFeedback[]
  customSignals       CustomSignal[]
  signalSubmissions   SignalTopicSubmission[]
  communityTopics     CommunitySignalTopic[]

  @@index([signupSource])
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String    @default("Default")
  keyHash     String    @unique
  keyPrefix   String
  lastUsedAt  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

model ApiLog {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String
  method       String
  statusCode   Int
  responseTime Int
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/** Fixed 1-minute window counters for per-plan API rate limits */
model ApiRateLimitWindow {
  userId    String
  windowKey String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, windowKey])
}

model MonitorTask {
  id                    String        @id @default(cuid())
  userId                String
  targetUsername        String
  keywords              String?
  notificationChannels  Json          @default("[]")
  isActive              Boolean       @default(true)
  status                MonitorStatus @default(ACTIVE)
  checkInterval         Int           @default(300)
  lastTweetId           String?
  lastError             String?
  lastCheckAt           DateTime?
  webhookUrl            String?
  webhookSecret         String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hits                  MonitorHit[]
  deliveries            MonitorWebhookDelivery[]

  @@index([userId])
  @@index([isActive, lastCheckAt])
}

model MonitorHit {
  id               String   @id @default(cuid())
  taskId           String
  tweetId          String
  text             String
  authorUsername   String
  tweetCreatedAt   DateTime?
  detectedAt       DateTime @default(now())

  task             MonitorTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deliveries       MonitorWebhookDelivery[]

  @@unique([taskId, tweetId])
  @@index([taskId, detectedAt])
}

model MonitorWebhookDelivery {
  id           String                 @id @default(cuid())
  taskId       String
  hitId        String?
  event        WebhookDeliveryEvent
  status       WebhookDeliveryStatus
  statusCode   Int?
  responseTime Int?
  error        String?
  createdAt    DateTime               @default(now())

  task         MonitorTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  hit          MonitorHit?            @relation(fields: [hitId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
}

model Job {
  id          String    @id @default(cuid())
  userId      String
  jobType     JobType
  payload     Json
  status      JobStatus @default(PENDING)
  priority    Int       @default(0)
  scheduledAt DateTime?
  executedAt  DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   @unique
  price       Float
  quotaLimit  Int
  features    Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model UserFeedback {
  id              String    @id @default(cuid())
  userId          String?
  email           String
  name            String?
  planTier        PlanTier?
  coreNeeds       Json      @default("[]")
  adoptionDrivers Json      @default("[]")
  message         String?
  userSource      String?
  userSourceDetail String?
  pageUrl         String?
  emailSent       Boolean   @default(false)
  emailError      String?
  createdAt       DateTime  @default(now())

  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([userId, createdAt])
  @@index([userSource])
}

/** Daily rollups for pageviews (pv/uv) and event counts — kept small via retention. */
model AnalyticsDaily {
  day    DateTime @db.Date
  metric String
  pv     Int      @default(0)
  uv     Int      @default(0)

  @@id([day, metric])
  @@index([metric])
}

/** Dedupes sessions per path per day for UV; pruned after ~30 days. */
model AnalyticsSessionDay {
  day       DateTime @db.Date
  metric    String
  sessionId String

  @@id([day, metric, sessionId])
  @@index([day])
}

/** Low-volume product events (signups, checkout, webhooks) — pruned after ~90 days. */
model ProductEvent {
  id        String   @id @default(cuid())
  event     String
  userId    String?
  sessionId String?
  path      String?
  props     Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum SignalTopicSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PredictorNiche {
  MACRO
  TRADING
  CRYPTO
  GEOPOLITICS
}

enum PredictorClaimStatus {
  OPEN
  HIT
  MISS
  INCONCLUSIVE
  EXPIRED
}

enum PredictorDiscoveryRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/** Private user-defined signal board (dashboard digest). */
model CustomSignal {
  id            String   @id @default(cuid())
  userId        String
  name          String
  watchAccounts String[]
  searchQuery   String?
  monitorKeywords String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/** User request to publish a new public /signals/{slug} topic. */
model SignalTopicSubmission {
  id           String                      @id @default(cuid())
  userId       String
  status       SignalTopicSubmissionStatus @default(PENDING)
  proposedSlug String
  category     String
  title        String
  description  String
  intro        String
  watchAccounts String[]
  searchQuery  String
  pulseLabel   String?
  adminNote    String?
  reviewedAt   DateTime?
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  communityTopic CommunitySignalTopic?

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

/** Approved community topic — merged into public /signals/{slug}. */
model CommunitySignalTopic {
  id            String   @id @default(cuid())
  slug          String   @unique
  submissionId  String   @unique
  submittedById String
  category      String
  title         String
  pageTitle     String
  description   String
  keywords      Json     @default("[]")
  intro         String
  watchAccounts Json
  searchQuery   String
  pulseLabel    String
  publishedAt   DateTime @default(now())

  submission SignalTopicSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submitter  User                  @relation(fields: [submittedById], references: [id], onDelete: Cascade)

  @@index([submittedById])
  @@index([publishedAt])
}

/** Discovered X account that makes market/macro predictions. */
model PredictorProfile {
  id              String         @id @default(cuid())
  username        String         @unique
  displayName     String?
  niche           PredictorNiche
  bio             String?
  followerCount   Int?
  discoveryScore  Float          @default(0)
  accuracyScore   Float?
  totalClaims     Int            @default(0)
  verifiedClaims  Int            @default(0)
  hitCount        Int            @default(0)
  missCount       Int            @default(0)
  lastScannedAt   DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  claims PredictorClaim[]

  @@index([niche, discoveryScore])
  @@index([accuracyScore])
}

/** Extracted prediction claim from a tweet. */
model PredictorClaim {
  id             String               @id @default(cuid())
  predictorId    String
  tweetId        String
  tweetText      String
  niche          PredictorNiche
  subject        String
  direction      String?
  claimSummary   String
  confidence     Float
  status         PredictorClaimStatus @default(OPEN)
  statusReason   String?
  tweetCreatedAt DateTime
  verifiedAt     DateTime?
  createdAt      DateTime             @default(now())

  predictor PredictorProfile @relation(fields: [predictorId], references: [id], onDelete: Cascade)

  @@unique([predictorId, tweetId])
  @@index([predictorId, tweetCreatedAt])
  @@index([status, tweetCreatedAt])
}

/** Background discovery run log. */
model PredictorDiscoveryRun {
  id          String                      @id @default(cuid())
  status      PredictorDiscoveryRunStatus @default(PENDING)
  niche       PredictorNiche?
  seedsScanned Int                        @default(0)
  authorsFound Int                        @default(0)
  claimsAdded  Int                        @default(0)
  startedAt   DateTime                    @default(now())
  finishedAt  DateTime?
  error       String?
}
